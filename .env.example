# medical-chatbot environment example
# Copy to .env for local development. Do not commit real secrets.

# -----------------------------------------------------------------------------
# Google Cloud / Firestore
# -----------------------------------------------------------------------------
FIRESTORE_PROJECT_ID=medical-chatbot-494315

# Local dev can use (default). Test Cloud Run should use medical-chatbot-test.
FIRESTORE_DATABASE_ID=medical-chatbot-test

# Local service-account JSON. Leave empty to use Application Default Credentials.
# For Cloud Run, leave unset and use the runtime service account.
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/google-service-account.json

# -----------------------------------------------------------------------------
# Admin endpoint auth
# -----------------------------------------------------------------------------
# Local: token
# Cloud Run test/prod: oidc
ADMIN_AUTH_MODE=token
ADMIN_SYNC_TOKEN=local-admin-token

# Required only when ADMIN_AUTH_MODE=oidc or token_or_oidc.
# Cloud Run deploy-test.sh sets ADMIN_OIDC_AUDIENCE to the deployed service URL.
ADMIN_OIDC_AUDIENCE=

# Comma-separated Google account/service-account emails allowed to call /admin/*.
# Example for manual smoke test:
# ADMIN_OIDC_ALLOWED_EMAILS
ADMIN_OIDC_ALLOWED_EMAILS=

# -----------------------------------------------------------------------------
# Google Drive source of truth
# -----------------------------------------------------------------------------
# Prefer folder ID. If empty, the app searches by GOOGLE_DRIVE_ROOT_FOLDER_NAME.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=medical-chatbot-local
PATIENTS_FOLDER_NAME=patients
SYSTEM_FOLDER_NAME=_system
PATIENT_FOLDER_NAME_REGEX=^(.+)_([12]\d{7})$

# Test/staging should not share the same scope id as production.
DRIVE_CHANGES_SCOPE_ID=test
DRIVE_PATIENT_BOOTSTRAP_ON_FULL_SYNC=true
FOLDER_INDEX_BOOTSTRAP_ON_CHANGES=true

# -----------------------------------------------------------------------------
# Drive sync limits
# -----------------------------------------------------------------------------
MAX_CHANGES_PER_RUN=20
MAX_CHANGES_PAGES_PER_RUN=5
MAX_WIKI_PAGE_GENERATIONS_PER_RUN=3
MAX_WIKI_BACKLOG_PER_RUN=10
CHANGES_SYNC_LOCK_LEASE_MINUTES=2
FULL_SYNC_LOCK_LEASE_MINUTES=10

# -----------------------------------------------------------------------------
# Gemini Files API runtime
# -----------------------------------------------------------------------------
GEMINI_API_KEY=replace-with-your-gemini-api-key
FILE_READY_WAIT_SECONDS=30
FILE_READY_POLL_INTERVAL_SECONDS=3
FILE_UPLOAD_LOCK_LEASE_SECONDS=600
FILE_UPLOAD_MAX_RETRY_COUNT=3
FILE_EXPIRATION_MARGIN_SECONDS=300

GEMINI_FILES_STORAGE_SOFT_LIMIT_BYTES=15032385536
GEMINI_FILES_STORAGE_TARGET_BYTES=12884901888
GEMINI_FILES_STORAGE_HARD_LIMIT_BYTES=18253611008
GEMINI_FILES_CLEANUP_BATCH_SIZE=20

GEMINI_FILE_PREWARM_ENABLED=true
GEMINI_FILE_PREWARM_MAX_ATTEMPTS=3
GEMINI_FILE_PREWARM_LEASE_SECONDS=570
GEMINI_FILE_PREWARM_IDEMPOTENCY_BUCKET_MINUTES=60
GEMINI_FILE_PREWARM_EXPIRY_MINUTES=30
GEMINI_FILE_PREWARM_DISPATCH_DEADLINE_SECONDS=600

# -----------------------------------------------------------------------------
# Kakao auth/session/callback jobs
# -----------------------------------------------------------------------------
SESSION_TTL_MINUTES=1440

# Local quick smoke test: background
# Cloud Run test/prod: cloud_tasks
CALLBACK_WORKER_MODE=cloud_tasks
CALLBACK_JOB_LEASE_SECONDS=55
CALLBACK_JOB_MAX_ATTEMPTS=5
CALLBACK_JOB_BATCH_SIZE=10
CALLBACK_JOB_EXPIRY_MINUTES=1
CALLBACK_JOB_RETRY_BACKOFF_SECONDS=0
KAKAO_CALLBACK_TIMEOUT_SECONDS=5
CALLBACK_PROCESSING_BUDGET_SECONDS=50

# -----------------------------------------------------------------------------
# Cloud Run / Cloud Tasks
# -----------------------------------------------------------------------------
CLOUD_RUN_TIMEOUT_SECONDS=900
ASYNC_WORKER_PROCESSING_TIMEOUT_SECONDS=540

CLOUD_TASKS_PROJECT_ID=medical-chatbot-494315
CLOUD_TASKS_LOCATION=asia-northeast3
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=medical-chatbot-test-scheduler@medical-chatbot-494315.iam.gserviceaccount.com

# Cloud Run deploy scripts set these to the deployed service URL after deploy.
CLOUD_TASKS_BASE_URL=
CLOUD_TASKS_AUDIENCE=

CALLBACK_TASKS_QUEUE_NAME=medical-chatbot-test-callback-jobs
CALLBACK_TASKS_DISPATCH_DEADLINE_SECONDS=60
PREWARM_TASKS_QUEUE_NAME=medical-chatbot-test-prewarm
WIKI_REBUILD_WORKER_MODE=cloud_tasks
WIKI_REBUILD_TASKS_QUEUE_NAME=medical-chatbot-test-wiki-rebuild
WIKI_REBUILD_TASKS_DISPATCH_DEADLINE_SECONDS=600

# Deployment-only queue throttling values used by deploy.sh/deploy-test.sh.
CALLBACK_TASKS_MAX_DISPATCHES_PER_SECOND=2
CALLBACK_TASKS_MAX_CONCURRENT_DISPATCHES=5
CALLBACK_TASKS_MAX_ATTEMPTS=5
CALLBACK_TASKS_MIN_BACKOFF=5s
CALLBACK_TASKS_MAX_BACKOFF=10s
CALLBACK_TASKS_MAX_DOUBLINGS=1
CALLBACK_TASKS_MAX_RETRY_DURATION=60s

PREWARM_TASKS_MAX_DISPATCHES_PER_SECOND=0.2
PREWARM_TASKS_MAX_CONCURRENT_DISPATCHES=1
PREWARM_TASKS_MAX_ATTEMPTS=3
PREWARM_TASKS_MIN_BACKOFF=60s
PREWARM_TASKS_MAX_BACKOFF=300s
PREWARM_TASKS_MAX_DOUBLINGS=2
PREWARM_TASKS_MAX_RETRY_DURATION=1200s

WIKI_REBUILD_TASKS_MAX_DISPATCHES_PER_SECOND=0.5
WIKI_REBUILD_TASKS_MAX_CONCURRENT_DISPATCHES=2
WIKI_REBUILD_TASKS_MAX_ATTEMPTS=4
WIKI_REBUILD_TASKS_MIN_BACKOFF=60s
WIKI_REBUILD_TASKS_MAX_BACKOFF=300s
WIKI_REBUILD_TASKS_MAX_DOUBLINGS=2
WIKI_REBUILD_TASKS_MAX_RETRY_DURATION=1800s

# -----------------------------------------------------------------------------
# Gemini final QA
# -----------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=3072
GEMINI_THINKING_LEVEL=low
GEMINI_HTTP_TIMEOUT_MS=540000

# -----------------------------------------------------------------------------
# Medical Wiki source_summary extraction
# -----------------------------------------------------------------------------
# Local quick fake tests: metadata
# Real Drive/Gemini test: gemini
MEDICAL_WIKI_EXTRACTION_MODE=gemini
GEMINI_WIKI_MODEL=gemini-3.5-flash
GEMINI_WIKI_TEMPERATURE=0.0
GEMINI_WIKI_MAX_OUTPUT_TOKENS=2048
GEMINI_WIKI_THINKING_LEVEL=low

# -----------------------------------------------------------------------------
# Medical Wiki Router
# -----------------------------------------------------------------------------
ROUTER_MODE=gemini
GEMINI_ROUTER_MODEL=gemini-3.5-flash
GEMINI_ROUTER_TEMPERATURE=0.0
GEMINI_ROUTER_MAX_OUTPUT_TOKENS=1024
GEMINI_ROUTER_THINKING_LEVEL=low
ROUTER_MIN_CONFIDENCE=0.55
ROUTER_MAX_CATALOG_PAGES=30

# -----------------------------------------------------------------------------
# Markdown parsing PoC
# -----------------------------------------------------------------------------
GEMINI_PARSING_MODEL=gemini-3-flash-preview
GEMINI_PARSING_MAX_OUTPUT_TOKENS=32768
GEMINI_PARSING_TEMPERATURE=0.0
GEMINI_PARSING_TOP_K=1
GEMINI_PARSING_THINKING_LEVEL=minimal
GEMINI_CONTEXT_CACHE_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
